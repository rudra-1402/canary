{
  "apps/{web,api}/**/*.{js,jsx}": ["prettier --write", "eslint --fix"],
  "packages/**/*.js": ["prettier --write", "eslint --fix"],
  "*.{json,md}": ["prettier --write"],
  "apps/intelligence/**/*.py": [
